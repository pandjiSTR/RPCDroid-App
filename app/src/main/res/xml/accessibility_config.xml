<?xml version="1.0" encoding="utf-8"?>
<!--
  typeWindowStateChanged: sinyal cepat saat app berganti.
  canRetrieveWindowContent: HANYA dipakai untuk membaca nama package jendela aktif (rootInActiveWindow.packageName)
  sebagai pemeriksaan "game masih di layar depan?". Isi layar tidak dibaca atau disimpan.
  Sengaja TANPA notificationTimeout: dengan timeout, sistem menggabungkan event bertipe sama dan membuang yang lama,
  sehingga event launcher bisa hilang tertimpa event systemui.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description" />
